{
  "name": "QMK Workspace",
  "image": "qmkfm/qmk_cli:latest",
  // 在 container 建立前（在主機上執行，兩項並行）：
  // 1. 初始化鍵盤 submodule（空資料夾掛載進去會蓋掉 qmk_firmware 對應路徑）
  // 2. 把 qmk_firmware clone 進 named volume（只有第一次會執行）
  "initializeCommand": {
    "submodules": ["git", "submodule", "update", "--init"],
    "qmk-firmware": [
      "docker", "run", "--rm",
      "-v", "qmk_firmware_dir:/qmk_firmware",
      "qmkfm/qmk_cli:latest",
      "sh", "-c", "[ -d /qmk_firmware/.git ] || qmk setup -y"
    ]
  },
  // 龐大的 qmk_firmware 放在 named volume，不用每次重新 clone。
  // 本 repo 是 QMK External Userspace，掛載在這個 image 預設的 /qmk_userspace（環境變數 QMK_USERSPACE），
  // 所以不用 qmk config user.overlay_dir。
  // 自訂 keyboard、community layout 與 users 不在 userspace 範圍內，由 make link 用符號連結放進 qmk_firmware。
  "workspaceMount": "source=${localWorkspaceFolder},target=/qmk_userspace,type=bind",
  "workspaceFolder": "/qmk_userspace",
  "mounts": [
    "source=qmk_firmware_dir,target=/qmk_firmware,type=volume"
  ],
  "postStartCommand": "make link",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "amodio.toggle-excluded-files",
        "EditorConfig.EditorConfig",
        "xaver.clang-format",
        "llvm-vs-code-extensions.vscode-clangd",
        "bierner.github-markdown-preview",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "files.associations": {
          "*.h": "c",
          "rules.mk": "makefile"
        }
      }
    }
  }
}